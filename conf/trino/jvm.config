-server
-agentpath:/usr/lib/trino/bin/libjvmkill.so

# Explicit heap instead of the image default of
#   -XX:InitialRAMPercentage=80 / -XX:MaxRAMPercentage=80
#
# Those percentages are of whatever memory the JVM can see. With no
# container limit that was the whole Docker VM (~6.2 GiB of 7.65), and the
# kernel OOM-killed Trino mid-dbt-build. Adding a 2.5 GiB container cap did
# not fix it either: 80% of 2.5 GiB is 2 GiB of heap, and metaspace, the
# 256 MiB reserved code cache, direct byte buffers and thread stacks then
# pushed total RSS past the cap. A percentage of the cap can never leave
# room for the non-heap memory that lives inside the same cap.
#
# So: pin the heap at 2 GiB and give the container 4 GiB, leaving ~2 GiB of
# genuine headroom for everything that is not heap. 2 GiB of heap is ample
# at this data volume -- the whole gold layer is a few hundred thousand rows.
-Xms1G
-Xmx2G

-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+HeapDumpOnOutOfMemoryError
-XX:+ExitOnOutOfMemoryError
-XX:-OmitStackTraceInFastThrow
-XX:ReservedCodeCacheSize=256M
-XX:PerMethodRecompilationCutoff=10000
-XX:PerBytecodeRecompilationCutoff=10000
-Djdk.attach.allowAttachSelf=true
-Djdk.nio.maxCachedBufferSize=2000000
-Dfile.encoding=UTF-8
# Allow loading dynamic agent used by JOL
-XX:+EnableDynamicAgentLoading
# https://bugs.openjdk.org/browse/JDK-8327134
-Djava.security.manager=allow
