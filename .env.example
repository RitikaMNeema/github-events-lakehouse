# ---- Object storage (MinIO stands in for S3) ----
MINIO_ROOT_USER=lakeadmin
MINIO_ROOT_PASSWORD=lakeadmin123
LAKE_BUCKET=lakehouse
AWS_ACCESS_KEY_ID=lakeadmin
AWS_SECRET_ACCESS_KEY=lakeadmin123
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000

# ---- Postgres: Airflow metadata + Iceberg JDBC catalog ----
POSTGRES_USER=lake
POSTGRES_PASSWORD=lake
POSTGRES_DB=airflow
ICEBERG_CATALOG_DB=iceberg

# ---- Iceberg ----
ICEBERG_CATALOG=lake
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse

# ---- Default local slice. KEEP THIS SMALL: ~1GB uncompressed per hour. ----
# 48 hours is a few GB gzipped and fits comfortably in your free disk.
GHA_START=2026-11-01T00
GHA_END=2026-11-02T23

# ---- Spark (local mode inside the Airflow image) ----
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
