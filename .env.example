# ---- Object storage (SeaweedFS stands in for S3) ----
# To run against real S3: clear S3_ENDPOINT and supply real keys.
# No code changes are needed.
LAKE_BUCKET=lakehouse
AWS_ACCESS_KEY_ID=lakeadmin
AWS_SECRET_ACCESS_KEY=lakeadmin123
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333

# ---- Postgres: Airflow metadata + Iceberg JDBC catalog ----
POSTGRES_USER=lake
POSTGRES_PASSWORD=lake
POSTGRES_DB=airflow
ICEBERG_CATALOG_DB=iceberg

# ---- Iceberg ----
ICEBERG_CATALOG=lake
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse

# ---- Default local slice ----
# A HISTORICAL window, deliberately.
#
# The recent GH Archive feed is heavily degraded. Measured 2026-11-01-12:
# 4,720 events, 5.8 MB gzipped, and NO PushEvent at all. Measured
# 2023-06-15-12: 198,897 events, 90.7 MB gzipped, 62% PushEvent.
# Recent data would leave silver.commits empty and commit_count null.
#
# At ~90 MB gzipped / ~673 MiB uncompressed per hour, 6 hours is about
# 540 MB gzipped. A sane first run; widen once it works.
GHA_START=2023-06-15T00
GHA_END=2023-06-15T05

# ---- Spark (local mode inside the Airflow image) ----
SPARK_MASTER=local[*]
# 2g, not 4g: Trino needs ~2.5g and the Docker VM has 7.7 GiB total.
# Raise both if you give Docker Desktop more memory.
SPARK_DRIVER_MEMORY=2g
